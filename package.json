{
  "name": "pieno",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.static.config.ts --host 127.0.0.1",
    "build": "vite build --config vite.static.config.ts && node scripts/build-pwa.mjs",
    "update-data": "node scripts/update-data.mjs",
    "check-data": "node scripts/check-data.mjs",
    "check-search": "node --experimental-strip-types scripts/check-search.mjs",
    "check-experience": "node --experimental-strip-types scripts/check-experience.mjs",
    "check-update": "node scripts/check-update.mjs"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "leaflet": "1.9.4",
    "lucide-react": "^1.31.0"
  },
  "devDependencies": {
    "vite": "8.0.13",
    "typescript": "5.9.3",
    "@vitejs/plugin-react": "6.0.2",
    "@types/leaflet": "^1.9.21",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/node": "22.19.19"
  }
}
